{
  "name": "@usezend/node",
  "version": "0.2.1",
  "description": "Official Node.js/TypeScript client for the Zend messaging platform",
  "license": "MIT",
  "author": "Zend",
  "homepage": "https://github.com/usezend/zend-node#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usezend/zend-node.git"
  },
  "bugs": {
    "url": "https://github.com/usezend/zend-node/issues"
  },
  "keywords": [
    "zend",
    "sms",
    "whatsapp",
    "voice",
    "email",
    "otp",
    "messaging",
    "sdk"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "prettier": "^3.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  }
}
